        "Content-Type": "application/json"
      },
      "bodyAbsent": false,
      "body": "[{\"jsonrpc\":\"2.0\",\"id\":101,\"result\":{\"sum\":5}},{\"jsonrpc\":\"2.0\",\"id\":102,\"result\":{\"sum\":9}}]"
    }
  },
  {
    "name": "fetch-rejection-get",
    "origin": "fetch",
    "request": {
