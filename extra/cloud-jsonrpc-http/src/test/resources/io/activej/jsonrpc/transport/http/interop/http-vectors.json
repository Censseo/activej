      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "bodyAbsent": false,
      "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"sum\":5}}"
    }
  },
  {
    "name": "fetch-notification",
    "origin": "fetch",
    "request": {
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "User-Agent": "node-fetch (undici)"
      },
      "body": "{\"jsonrpc\":\"2.0\",\"method\":\"test.notify\",\"params\":{\"message\":\"hello from fetch\"}}"
    },
    "expect": {
      "status": 204,
      "headers": {},
      "bodyAbsent": true
    }
  },
  {
    "name": "fetch-batch",
    "origin": "fetch",
